PORT=8181
HOST=0.0.0.0
REDIS_URL=redis://127.0.0.1:6379
STATE_NAMESPACE=trinitymatrix:v1
# PostgreSQL is durable application history. Valkey remains authoritative for sessions and active game snapshots.
DATABASE_URL=postgresql://trinitymatrix:trinitymatrix@127.0.0.1:5433/trinitymatrix
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=5
# Set true after production/staging database bootstrap and migrations have succeeded.
DURABLE_DATA_REQUIRED=false
# Generate with: openssl rand -base64 32. Production requires a unique secret and verify-full database TLS.
CHAT_ENCRYPTION_KEY=
CHAT_ENCRYPTION_KEY_VERSION=1
ADMIN_EMAILS=admin@example.com
# Additional server-held factor required by the admin portal in production/staging.
ADMIN_ACCESS_SECRET=replace-with-a-separate-random-admin-access-secret
AUTH_PROVIDER=mock
MOCK_OTP_CODE=123456
OTP_HASH_SECRET=replace-with-at-least-32-random-characters
# Required only when AUTH_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=TrinityMatrix <login@example.com>
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:8180,http://localhost:8180
# Number of trusted reverse-proxy hops. Use 1 for ALB -> app or 2 for CloudFront -> ALB -> app.
TRUST_PROXY=false
LOG_LEVEL=info
WEB_DIST_PATH=../web/dist
APP_VERSION=development
APP_REVISION=unknown
APP_BUILD_TIME=unknown
SHUTDOWN_GRACE_PERIOD_MS=10000
# Model-backed AI opponents require PostgreSQL. Keep the key server-side.
AI_PLAYERS_ENABLED=false
# OPENROUTER_API_KEY=your-server-only-key
# Shared across all AI players and matches, resets at midnight UTC.
AI_DAILY_BUDGET_USD=10
# Public opt-in match broadcasts require PostgreSQL and the single-instance runtime.
# Hands and outcomes are withheld by the server for 120 seconds.
BROADCASTS_ENABLED=false
BROADCAST_MEDIA_ENABLED=false
BROADCAST_MEDIA_URL=http://127.0.0.1:8182
# Generate a separate secret with openssl rand -hex 32, shared only with the private media worker.
BROADCAST_MEDIA_SECRET=
BROADCAST_MAX_VIDEO_STREAMS=1
