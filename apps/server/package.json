{
  "name": "@trinitymatrix/server",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --import ./register-sql-loader.mjs --watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "db:migrate": "node --enable-source-maps dist/db/migrate-cli.js",
    "db:migrate:dev": "node --import tsx --import ./register-sql-loader.mjs src/db/migrate-cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.10",
    "@fastify/websocket": "11.3.0",
    "@trinitymatrix/game-domain": "0.1.0",
    "@trinitymatrix/protocol": "0.1.0",
    "@simplewebauthn/server": "13.3.3",
    "fastify": "5.12.8",
    "pg": "8.16.3",
    "redis": "6.2.1",
    "ws": "8.21.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/pg": "8.15.5",
    "@types/ws": "8.18.1",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "vitest": "4.1.11"
  }
}
